# Copie para `.env` e ajuste. O `.env` é ignorado pelo git.
# A maioria é opcional (há defaults em moneymin/config.py). MINUTE_INVITE_CODE
# e CROWTADO_REF são imutáveis, fixos no código.

# Base da minute-api
MINUTE_BASE_URL=https://minute-api-production.nicebush-c949d8c8.eastus2.azurecontainerapps.io

# Firebase Web API key (vem do APK; sobrescrevível)
MINUTE_FIREBASE_API_KEY=

# Versão do app enviada nos headers. O backend exige >= 1.21.0
# (erro app_version_too_old para versões antigas — verificado 08/08).
# App Store já está em 1.22.0 (13/08/2026) — usar a mais recente.
MINUTE_APP_VERSION=1.22.0

# Accept-Language enviado nos headers (padrão pt-BR).
# MINUTE_ACCEPT_LANGUAGE=pt-BR,pt;q=0.9

# Teto do cache de MP4 por aparelho em data/ego4d/ (0 = sem teto).
# MINUTE_VIDEO_CACHE_GB=40

# Código de convite da org no Minute (usado no registro de contas).
# IMUTÁVEL: fixo em moneymin/config.py (INVITE_CODE) — não configurável via .env.

# --- Hostinger Mail (caixa catch-all para códigos de verificação) ------------
# Token da API: hPanel -> Advanced -> API. Sem default — obrigatório no .env.
HOSTINGER_MAIL_TOKEN=
# resourceId da caixa (opcional; sem ele usa a primeira caixa da conta).
HOSTINGER_MAILBOX_ID=

# Referral do crowtado (sign-up com bônus de indicação).
# IMUTÁVEL: fixo em moneymin/config.py (CROWTADO_REF) — não configurável via .env.

# --- Perfil nativo do app iOS (réplica do upload) ----------------------------
# Valores que o app real envia. Defaults corretos via moneymin/config.py —
# só sobrescreva se você souber que o backend mudou o contrato.

# Formato curto do POST /uploads (captura iOS 072): só o modelo.
# MINUTE_NATIVE_DEVICE_MODEL=iPhone 13
# MINUTE_NATIVE_PLATFORM_OS=ios
# Fonte da câmera ("built-in" ou "external").
# MINUTE_NATIVE_CAMERA_SOURCE=built-in
# Formato COMPLETO do device dentro do sidecar (.data.zip).
# MINUTE_NATIVE_SIDECAR_MODEL=iPhone14,5
# MINUTE_NATIVE_SIDECAR_SYSTEM_NAME=iOS
# MINUTE_NATIVE_SIDECAR_SYSTEM_VERSION=26.5
# clockOffsetNs real (gravação d9f4fa6f, iOS 26.5.2).
# MINUTE_NATIVE_CLOCK_OFFSET_NS=-125
# Perfil AWS autorizado para o Ego4D. Use vazio para credenciais via ambiente.
EGO4D_AWS_PROFILE=default
# Normalmente pode ficar vazio: o cliente descobre a região real do bucket.
EGO4D_AWS_REGION=
